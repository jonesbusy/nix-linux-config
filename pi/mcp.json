{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}"
      }
    },
    "quarkus-agent": {
      "command": "jbang",
      "args": ["quarkus-agent-mcp@quarkusio"]
    },
    "huginn": {
      "command": "jbang",
      "args": ["--quiet", "huginn-mcp@maveniverse"]
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "exposure": "codemode",
      "description": "AWS API access and AWS documentation via AWS managed remote MCP server (AWS CLI credentials)."
    }
  }
}
