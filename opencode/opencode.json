{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github-copilot": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GH_TOKEN}"
      }
    },
    "quarkus-agent": {
      "type": "local",
      "command": ["jbang", "quarkus-agent-mcp@quarkusio"],
      "enabled": true
    },
    "huginn": {
      "type": "local",
      "command": ["jbang", "--quiet", "huginn-mcp@maveniverse"],
      "enabled": true
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "enabled": true
    }
  }
}
