{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigests"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update version-pinned npm packages declared in Pi settings",
      "managerFilePatterns": ["/^pi\\/settings\\.json$/"],
      "matchStrings": [
        "npm:(?<depName>(?:@[^/\"]+/)?[^@\"]+)@(?<currentValue>[^\"]+)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ]
}
